# Load these in your shell or process manager; rag-core does not load dotenv files.
RAG_CORE_QDRANT_LOCATION=./rag-index
RAG_CORE_EMBEDDING_PROVIDER=local
RAG_CORE_HYBRID=true
# For remote Qdrant, replace LOCATION with URL and set QDRANT_API_KEY.
# For OpenAI-compatible embeddings, install the openai extra and set:
# RAG_CORE_EMBEDDING_PROVIDER=openai
# RAG_CORE_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=
# RAG_CORE_EMBEDDING_BASE_URL=
